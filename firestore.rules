rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Basic helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin by email (God Mode) - No DB read needed
    function isEmailAdmin() {
      return isSignedIn() && request.auth.token.email == 'vkatakam@gitam.edu';
    }

    // Admin by role - Requires one DB read
    function isRoleAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    // General admin check
    function isAdmin() {
      return isEmailAdmin() || isRoleAdmin();
    }

    // User Profile Security
    match /userProfiles/{userId} {
      // Owners can manage their own profile without recursion
      allow read, create, update: if isOwner(userId);
      
      // Email Admin can manage all profiles
      allow read, write: if isEmailAdmin();
      
      // Role-based Admins can manage others (short-circuit on isOwner to prevent recursion)
      allow read, update, delete: if isSignedIn() && !isOwner(userId) && isRoleAdmin();
    }

    // Material validation
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Building validation
    match /buildings/{buildingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Vendor validation
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Transaction validation
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings)
      );
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Purchase validation
    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Requisition validation
    match /requisitions/{requisitionId} {
      allow read, update: if isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings)
      );
      allow create: if isSignedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         request.resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings)
      );
      allow delete: if isAdmin();
    }

    // Notification validation
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.userId
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }
  }
}



