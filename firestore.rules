rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core check: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Core check: Is this the primary admin?
    function isPrimaryAdmin() {
      return isSignedIn() && request.auth.token.email == 'vkatakam@gitam.edu';
    }

    // Helper: Check if a user is an admin via their profile document
    // NOTE: This triggers a read on the userProfiles collection.
    function isProfileAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Comprehensive Admin check
    function isAdmin() {
      return isPrimaryAdmin() || isProfileAdmin();
    }

    // Building-level access check
    function hasBuildingAccess(buildingName) {
      return isPrimaryAdmin() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
          buildingName in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings
        )
      );
    }

    // User Profile Security
    match /userProfiles/{userId} {
      // Users can always access their own profile.
      allow read, write: if isSignedIn() && request.auth.uid == userId;
      
      // Primary admin can access everything.
      allow read, write: if isPrimaryAdmin();
      
      // Other admins can manage profiles (except the primary admin's if it exists).
      allow read, update, delete: if isSignedIn() && userId != request.auth.uid && isProfileAdmin();
    }

    // Material validation
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Building validation
    match /buildings/{buildingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Vendor validation
    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Transaction validation
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (isPrimaryAdmin() || hasBuildingAccess(resource.data.building));
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Purchase validation
    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Requisition validation
    match /requisitions/{requisitionId} {
      allow read: if isSignedIn() && (isPrimaryAdmin() || hasBuildingAccess(resource.data.building));
      allow create: if isSignedIn() && (isPrimaryAdmin() || hasBuildingAccess(request.resource.data.building));
      allow update: if isSignedIn() && (isPrimaryAdmin() || hasBuildingAccess(resource.data.building));
      allow delete: if isAdmin();
    }

    // Notification validation
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isPrimaryAdmin() || request.auth.uid == resource.data.userId || isProfileAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isPrimaryAdmin());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isPrimaryAdmin());
    }
  }
}
