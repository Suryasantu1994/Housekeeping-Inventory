rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile Security
    match /userProfiles/{userId} {
      // 1. Users can always read/write their own profile. 
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // 2. Admins can read and manage other profiles.
      allow read, write: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Material validation
    match /materials/{materialId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Building validation
    match /buildings/{buildingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Vendor validation
    match /vendors/{vendorId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Transaction validation
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings
      );
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Purchase validation
    match /purchases/{purchaseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Requisition validation
    match /requisitions/{requisitionId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings
      );
      allow create: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
        request.resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings
      );
      allow update: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin' ||
        resource.data.building in get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.assignedBuildings
      );
      allow delete: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Notification validation
    match /notifications/{notificationId} {
      allow read: if request.auth != null && (
        request.auth.token.email == 'vkatakam@gitam.edu' ||
        request.auth.uid == resource.data.userId ||
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'admin'
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.email == 'vkatakam@gitam.edu'
      );
      allow delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        request.auth.token.email == 'vkatakam@gitam.edu'
      );
    }
  }
}
